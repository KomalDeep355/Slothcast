# Copy to .env — never commit .env
GITHUB_USER=
GITHUB_TOKEN=
SLOTHCAST_TZ=UTC
OLLAMA_URL=http://localhost:11434
SLOTHCAST_GEMMA_MODEL=gemma3:4b
# Optional hosted habit coach. Configure all three values to enable it.
# Aggregated check-in statistics are sent to this provider when coaching is requested.
SLOTHCAST_LLM_BASE_URL=
SLOTHCAST_LLM_API_KEY=
SLOTHCAST_LLM_MODEL=
# local = weights run on your machine; client = data is sent to Prior Labs' API
SLOTHCAST_TABPFN_MODE=local
SENTRY_DSN=
TEMPORAL_ADDRESS=localhost:7233
